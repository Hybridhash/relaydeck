diff --color -ruN -x .swiftpm a/test/file_picker_web_backport_test.dart b/test/file_picker_web_backport_test.dart
--- a/test/file_picker_web_backport_test.dart
+++ b/test/file_picker_web_backport_test.dart
@@ -0,0 +1,328 @@
+@TestOn('browser')
+library;
+
+// RD1 backport tests: the Safari/iOS attachment fix for file_picker 11.0.3.
+// Run with: flutter test --platform chrome test/file_picker_web_backport_test.dart
+// (needs Chrome; headless is fine — no real dialog interaction required).
+
+import 'dart:js_interop';
+
+import 'package:file_picker/src/api/file_picker_types.dart';
+import 'package:file_picker/src/platform/file_picker_platform_interface.dart';
+import 'package:file_picker/src/platform/web/file_picker_web.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_web_plugins/flutter_web_plugins.dart';
+import 'package:web/web.dart';
+
+// registerWith ignores its argument; this only satisfies the signature.
+class FakeRegistrar implements Registrar {
+  @override
+  dynamic noSuchMethod(Invocation invocation) => super.noSuchMethod(invocation);
+}
+
+void main() {
+  FilePickerWeb.registerWith(FakeRegistrar());
+
+  final FilePickerPlatform platform = FilePickerPlatform.instance;
+
+  // Container id from file_picker_web.dart (_kFilePickerInputsDomId).
+  Element target() =>
+      document.querySelector('#__file_picker_web-file-input')!;
+
+  HTMLInputElement attachedInput() =>
+      target().firstChild! as HTMLInputElement;
+
+  void selectFile(HTMLInputElement input, String name) {
+    final transfer = DataTransfer();
+    transfer.items.add(File(<JSAny>[].toJS, name));
+    input.files = transfer.files;
+  }
+
+  test('attaches container and input synchronously while pending', () async {
+    final future = platform.pickFiles();
+    // No await above: these run synchronously in the same task as the pick
+    // call, proving the gesture path attaches the input (WebKit only fires
+    // change for connected inputs).
+    expect(target().isConnected, isTrue);
+    final input = attachedInput();
+    expect(input.isConnected, isTrue);
+
+    selectFile(input, 'a.pdf');
+    input.dispatchEvent(Event('change'));
+
+    final result = await future;
+    expect(result?.files.single.name, 'a.pdf');
+    expect(target().childNodes.length, 0);
+    expect(input.isConnected, isFalse);
+  });
+
+  test('completes with the selected file on change and detaches', () async {
+    final future = platform.pickFiles();
+    final input = attachedInput();
+
+    selectFile(input, 'b.png');
+    input.dispatchEvent(Event('change'));
+
+    final result = await future;
+    expect(result?.files.single.name, 'b.png');
+    expect(target().childNodes.length, 0);
+    expect(input.isConnected, isFalse);
+  });
+
+  test('completes null on input cancel with blur-cancel disabled', () async {
+    final future = platform.pickFiles(cancelUploadOnWindowBlur: false);
+    final input = attachedInput();
+
+    input.dispatchEvent(Event('cancel'));
+
+    expect(await future, isNull);
+    expect(target().childNodes.length, 0);
+    expect(input.isConnected, isFalse);
+  });
+
+  test('delivers the selection when focus precedes change', () async {
+    final future = platform.pickFiles();
+    final input = attachedInput();
+
+    // Safari fires window focus before change once the dialog closes.
+    selectFile(input, 'c.jpg');
+    window.dispatchEvent(Event('focus'));
+
+    final result = await future;
+    expect(result?.files.single.name, 'c.jpg');
+    expect(target().childNodes.length, 0);
+    expect(input.isConnected, isFalse);
+  });
+
+  test('completes null on focus without a selection', () async {
+    final future = platform.pickFiles();
+
+    window.dispatchEvent(Event('focus'));
+
+    expect(await future, isNull);
+    expect(target().childNodes.length, 0);
+  });
+
+  test('completes empty instead of hanging on an empty change', () async {
+    final future = platform.pickFiles();
+    final input = attachedInput();
+
+    // Fresh input holds an empty selection; 11.0.3 never settled here.
+    input.dispatchEvent(Event('change'));
+
+    final result = await future;
+    expect(result, isNotNull);
+    expect(result!.files, isEmpty);
+    expect(target().childNodes.length, 0);
+    expect(input.isConnected, isFalse);
+  });
+
+  test('picks the same file twice', () async {
+    for (var i = 0; i < 2; i++) {
+      final future = platform.pickFiles();
+      final input = attachedInput();
+      selectFile(input, 'same.png');
+      input.dispatchEvent(Event('change'));
+      expect((await future)?.files.single.name, 'same.png');
+      expect(target().childNodes.length, 0);
+    }
+  });
+
+  test('a superseded attempt never removes the newer input', () async {
+    final first = platform.pickFiles();
+    final firstInput = attachedInput();
+
+    final second = platform.pickFiles();
+    final secondInput = attachedInput();
+
+    // The newer session retires the older input at start.
+    expect(firstInput.isConnected, isFalse);
+    expect(secondInput.isConnected, isTrue);
+    expect(target().childNodes.length, 1);
+
+    // The older attempt settles (null) via its own detached input
+    // without touching the newer one. (Window focus is not used here: it
+    // would also arm the newer attempt's focus-cancel timer.)
+    firstInput.dispatchEvent(Event('cancel'));
+    expect(await first, isNull);
+    expect(secondInput.isConnected, isTrue);
+    expect(target().firstChild, same(secondInput));
+
+    selectFile(secondInput, 'newer.pdf');
+    secondInput.dispatchEvent(Event('change'));
+    expect((await second)?.files.single.name, 'newer.pdf');
+    expect(target().childNodes.length, 0);
+  });
+
+  test('repeated cancelled attempts leave no residue', () async {
+    for (var i = 0; i < 3; i++) {
+      final future = platform.pickFiles(cancelUploadOnWindowBlur: false);
+      attachedInput().dispatchEvent(Event('cancel'));
+      expect(await future, isNull);
+      expect(target().childNodes.length, 0);
+    }
+
+    // The picker still works afterwards.
+    final future = platform.pickFiles();
+    final input = attachedInput();
+    selectFile(input, 'after.pdf');
+    input.dispatchEvent(Event('change'));
+    expect((await future)?.files.single.name, 'after.pdf');
+    expect(target().childNodes.length, 0);
+  });
+
+  group('supersede retires synchronously', () {
+    for (final blurCancel in [true, false]) {
+      test('second pick alone resolves the first (blurCancel=$blurCancel)',
+          () async {
+        final first =
+            platform.pickFiles(cancelUploadOnWindowBlur: blurCancel);
+        final firstInput = attachedInput();
+
+        final second =
+            platform.pickFiles(cancelUploadOnWindowBlur: blurCancel);
+
+        // No event was dispatched on the old input, yet the first pick
+        // resolves as cancelled instead of hanging.
+        expect(await first.timeout(const Duration(seconds: 2)), isNull);
+        expect(firstInput.isConnected, isFalse);
+
+        // Late events on the retired input are ignored.
+        selectFile(firstInput, 'late-$blurCancel.png');
+        firstInput.dispatchEvent(Event('cancel'));
+        firstInput.dispatchEvent(Event('change'));
+
+        // The new pick stays attached and succeeds.
+        final secondInput = attachedInput();
+        expect(secondInput.isConnected, isTrue);
+        selectFile(secondInput, 'second-$blurCancel.png');
+        secondInput.dispatchEvent(Event('change'));
+        expect((await second)?.files.single.name,
+            'second-$blurCancel.png');
+        expect(target().childNodes.length, 0);
+      });
+    }
+
+    test('a focus-armed timer cannot disturb the superseding pick',
+        () async {
+      final first = platform.pickFiles(cancelUploadOnWindowBlur: true);
+      final firstInput = attachedInput();
+
+      // Arm the old attempt's 1s focus timer, then supersede immediately.
+      window.dispatchEvent(Event('focus'));
+      final second = platform.pickFiles(cancelUploadOnWindowBlur: true);
+
+      expect(await first.timeout(const Duration(seconds: 2)), isNull);
+
+      // Let the old timer fire into the void.
+      await Future.delayed(const Duration(milliseconds: 1200));
+      expect(firstInput.isConnected, isFalse);
+
+      final secondInput = attachedInput();
+      expect(secondInput.isConnected, isTrue);
+      selectFile(secondInput, 'after-timer.png');
+      secondInput.dispatchEvent(Event('change'));
+      expect((await second)?.files.single.name, 'after-timer.png');
+      expect(target().childNodes.length, 0);
+    });
+  });
+
+  group('processing failures settle through one path', () {
+    test('Flet read-stream path delivers a consumable stream', () async {
+      final future = platform.pickFiles(withReadStream: true);
+      final input = attachedInput();
+      // Non-empty file so the chunk loop yields real bytes.
+      final transfer = DataTransfer();
+      transfer.items
+          .add(File(['rd34-stream-bytes'.toJS].toJS, 'data.bin'));
+      input.files = transfer.files;
+      input.dispatchEvent(Event('change'));
+
+      final result = await future.timeout(const Duration(seconds: 5));
+      final file = result?.files.single;
+      expect(file?.name, 'data.bin');
+      expect(file?.readStream, isNotNull);
+      final bytes = await file!.readStream!
+          .fold<List<int>>([], (all, chunk) => all..addAll(chunk));
+      expect(String.fromCharCodes(bytes), 'rd34-stream-bytes');
+      expect(target().childNodes.length, 0);
+      expect(input.isConnected, isFalse);
+    });
+
+    test('a throwing done listener cannot veto success', () async {
+      var calls = 0;
+      final future = platform.pickFiles(onFileLoading: (_) {
+        calls++;
+        if (calls > 1) throw StateError('synthetic done failure');
+      });
+      final input = attachedInput();
+      selectFile(input, 'ok.png');
+      input.dispatchEvent(Event('change'));
+
+      final result = await future.timeout(const Duration(seconds: 5));
+      expect(result?.files.single.name, 'ok.png');
+      expect(calls, 2); // picking + done (done threw, swallowed)
+      expect(target().childNodes.length, 0);
+    });
+
+    test('a throwing done listener cannot veto cancel', () async {
+      var calls = 0;
+      final future = platform.pickFiles(
+        cancelUploadOnWindowBlur: false,
+        onFileLoading: (_) {
+          calls++;
+          if (calls > 1) throw StateError('synthetic done failure');
+        },
+      );
+      attachedInput().dispatchEvent(Event('cancel'));
+      expect(await future.timeout(const Duration(seconds: 5)), isNull);
+      expect(calls, 2);
+      expect(target().childNodes.length, 0);
+    });
+
+    test('a throwing picking listener fails fast with no residue',
+        () async {
+      await expectLater(
+        platform.pickFiles(
+            onFileLoading: (_) =>
+                throw StateError('synthetic picking failure')),
+        throwsA(isA<StateError>()),
+      );
+      expect(target().childNodes.length, 0);
+    });
+
+    test('retire during pending delivery settles null without hanging',
+        () async {
+      final first = platform.pickFiles();
+      final firstInput = attachedInput();
+      selectFile(firstInput, 'inflight.png');
+      firstInput.dispatchEvent(Event('change'));
+      // Supersede before the change microtasks run.
+      final second = platform.pickFiles();
+
+      expect(await first.timeout(const Duration(seconds: 2)), isNull);
+
+      final secondInput = attachedInput();
+      selectFile(secondInput, 'next.png');
+      secondInput.dispatchEvent(Event('change'));
+      expect((await second)?.files.single.name, 'next.png');
+      expect(target().childNodes.length, 0);
+    });
+
+    test('duplicate settle signals complete once', () async {
+      final future = platform.pickFiles();
+      final input = attachedInput();
+      selectFile(input, 'once.png');
+      input.dispatchEvent(Event('change'));
+      input.dispatchEvent(Event('cancel'));
+      window.dispatchEvent(Event('focus'));
+
+      final result = await future.timeout(const Duration(seconds: 5));
+      expect(result?.files.single.name, 'once.png');
+      // No late timer mischief after the dust settles.
+      await Future.delayed(const Duration(milliseconds: 1200));
+      expect(target().childNodes.length, 0);
+      expect(input.isConnected, isFalse);
+    });
+  });
+}
